{
  "name": "@vm-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/ensure-env.mjs && node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node scripts/ensure-env.mjs && prisma migrate deploy && prisma generate",
    "db:seed": "node scripts/ensure-env.mjs && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vm-manager/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
