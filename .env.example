# Ejemplo de variables de entorno. Copia este archivo como apps/api/.env
# (y crea apps/web/.env cuando haga falta) y ajusta los valores.
# No subas secretos reales al repositorio.

# --- apps/api ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://vmuser:vmpass@localhost:5433/vmdb
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
COOKIE_SAMESITE=strict

# --- apps/web ---
VITE_API_BASE=/api
